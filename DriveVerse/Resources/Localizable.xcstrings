    "Drive Mode" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Drive Mode" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "驾驶模式" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "駕駛模式" } }
      }
    },
    "Drive Mode & battery" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Drive Mode & battery" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "驾驶模式与电池" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "駕駛模式與電池" } }
      }
    },
    "Drive Mode keeps DriveVerse awake in the background using a low-power location session, so lyrics keep updating on CarPlay and the lock screen while you drive. Locations are discarded immediately and never stored. It uses extra battery, so it's opt-in. This approach is fine for a personal sideloaded app but would not pass App Store review." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Drive Mode keeps DriveVerse awake in the background using a low-power location session, so lyrics keep updating on CarPlay and the lock screen while you drive. Locations are discarded immediately and never stored. It uses extra battery, so it's opt-in. This approach is fine for a personal sideloaded app but would not pass App Store review." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "驾驶模式使用低功耗定位会话让 DriveVerse 在后台保持运行，使歌词能在驾驶时持续更新到 CarPlay 和锁定屏幕。位置信息会立即丢弃，绝不会存储。此模式会增加耗电，因此需要手动开启；它适用于个人侧载版本，但不符合 App Store 审核要求。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "駕駛模式使用低耗電定位階段讓 DriveVerse 在背景保持執行，使歌詞能在駕駛時持續更新到 CarPlay 和鎖定畫面。位置資訊會立即捨棄，絕不儲存。此模式會增加耗電，因此需要手動開啟；它適用於個人側載版本，但不符合 App Store 審核要求。" } }
      }
    },
    "Drive Mode needs location access to stay alive in the background. Allow it for DriveVerse in Settings → Privacy & Security → Location Services." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Drive Mode needs location access to stay alive in the background. Allow it for DriveVerse in Settings → Privacy & Security → Location Services." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "驾驶模式需要定位权限才能在后台保持运行。请前往“设置”→“隐私与安全性”→“定位服务”，允许 DriveVerse 使用定位。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "駕駛模式需要定位權限才能在背景保持執行。請前往「設定」→「隱私權與安全性」→「定位服務」，允許 DriveVerse 使用定位。" } }
      }
    },
    "DriveVerse" : {
      "shouldTranslate" : false
    },
    "DriveVerse is a personal-use app. Lyrics are fetched from third-party services for private, non-commercial display. Do not distribute this app without licensed lyrics providers." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "DriveVerse is a personal-use app. Lyrics are fetched from third-party services for private, non-commercial display. Do not distribute this app without licensed lyrics providers." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "DriveVerse 是个人使用的应用。歌词来自第三方服务，仅用于私人、非商业展示。未获得歌词服务授权时，请勿分发本应用。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "DriveVerse 是個人使用的 App。歌詞來自第三方服務，僅用於私人、非商業顯示。未取得歌詞服務授權時，請勿散布本 App。" } }
      }
    },
    "Finding lyrics…" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Finding lyrics…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在查找歌词…" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在尋找歌詞…" } }
      }
    },
    "For smooth lyrics, turn on Settings → DriveVerse → Live Activities → More Frequent Updates." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "For smooth lyrics, turn on Settings → DriveVerse → Live Activities → More Frequent Updates." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "为了让歌词流畅更新，请前往“设置”→“DriveVerse”→“实时活动”，开启“更频繁更新”。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "為了讓歌詞流暢更新，請前往「設定」→「DriveVerse」→「即時動態」，開啟「更頻繁更新」。" } }
      }
    },
